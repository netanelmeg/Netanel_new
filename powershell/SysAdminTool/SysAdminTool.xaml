<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="SysAdmin Troubleshooting Tool"
        Height="820" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel>

    <!-- Connection bar -->
    <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="12,8">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Computer:" Foreground="White" VerticalAlignment="Center"
                   Margin="0,0,8,0" FontWeight="SemiBold"/>
        <TextBox x:Name="txtComputerName" Width="230" Text="localhost"
                 VerticalContentAlignment="Center" Padding="5,3"/>
        <Button x:Name="btnConnect" Content="Connect" Margin="8,0,0,0" Padding="14,5"/>
        <Ellipse x:Name="ellConnectionBadge" Width="13" Height="13" Fill="#808080"
                 Margin="16,0,5,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="txtConnectionStatus" Text="Local" Foreground="White"
                   VerticalAlignment="Center" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" BorderThickness="0,1,0,0"
               BorderBrush="#CCCCCC">
      <StatusBarItem Padding="6,2">
        <TextBlock x:Name="txtStatusBar" Text="Ready"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right" Padding="0,2,10,2">
        <ProgressBar x:Name="pbStatusBar" Width="200" Height="14"
                     IsIndeterminate="True" Visibility="Collapsed"/>
      </StatusBarItem>
    </StatusBar>

    <!-- Main tabs -->
    <TabControl x:Name="tabMain" Margin="6,4,6,4">

      <!-- ════════════════════ NETWORK TAB ════════════════════ -->
      <TabItem Header="Network">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">

            <!-- Ping -->
            <GroupBox Header="Ping" Margin="0,0,0,8" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="110"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                  <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0" Width="50"/>
                  <TextBox x:Name="txtPingTarget" Width="260" Padding="4,3" Text="8.8.8.8"/>
                  <TextBlock Text="Count:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  <TextBox x:Name="numPingCount" Width="52" Padding="4,3" Text="4"/>
                  <Button x:Name="btnPing" Content="Ping" Margin="10,0,0,0" Padding="14,5"/>
                </StackPanel>
                <DataGrid x:Name="dgPingResults" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#"               Binding="{Binding Seq}"         Width="42"/>
                    <DataGridTextColumn Header="Address"         Binding="{Binding Address}"     Width="190"/>
                    <DataGridTextColumn Header="Roundtrip (ms)"  Binding="{Binding RoundtripMs}" Width="120"/>
                    <DataGridTextColumn Header="Status"          Binding="{Binding Status}"      Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

            <!-- DNS Lookup -->
            <GroupBox Header="DNS Lookup" Margin="0,0,0,8" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="110"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                  <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" Width="50"/>
                  <TextBox x:Name="txtDnsName" Width="260" Padding="4,3" Text="microsoft.com"/>
                  <TextBlock Text="Server:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  <TextBox x:Name="txtDnsServer" Width="160" Padding="4,3"
                           ToolTip="Leave blank to use the system default DNS server"/>
                  <Button x:Name="btnDnsLookup" Content="Resolve" Margin="10,0,0,0" Padding="14,5"/>
                </StackPanel>
                <DataGrid x:Name="dgDnsResults" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"    Width="220"/>
                    <DataGridTextColumn Header="Type"    Binding="{Binding Type}"    Width="70"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="TTL"     Binding="{Binding TTL}"     Width="70"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

            <!-- TCP Port Test -->
            <GroupBox Header="TCP Port Test" Margin="0,0,0,8" Padding="8,6">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0" Width="50"/>
                  <TextBox x:Name="txtPortTarget" Width="220" Padding="4,3" Text="8.8.8.8"/>
                  <TextBlock Text="Port:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  <TextBox x:Name="txtPortNumber" Width="70" Padding="4,3" Text="443"/>
                  <TextBlock Text="Timeout (ms):" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  <TextBox x:Name="numPortTimeout" Width="70" Padding="4,3" Text="3000"/>
                  <Button x:Name="btnPortTest" Content="Test Port" Margin="10,0,0,0" Padding="14,5"/>
                </StackPanel>
                <TextBlock x:Name="txtPortResult" FontWeight="SemiBold" FontSize="14"
                           Margin="0,2,0,0" MinHeight="20"/>
              </StackPanel>
            </GroupBox>

            <!-- Traceroute -->
            <GroupBox Header="Traceroute" Margin="0,0,0,8" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                  <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0" Width="50"/>
                  <TextBox x:Name="txtTraceTarget" Width="260" Padding="4,3" Text="8.8.8.8"/>
                  <Button x:Name="btnTraceroute"  Content="Trace Route" Margin="10,0,0,0" Padding="14,5"/>
                  <Button x:Name="btnCancelTrace" Content="Cancel"       Margin="6,0,0,0"  Padding="14,5"
                          Visibility="Collapsed"/>
                </StackPanel>
                <DataGrid x:Name="dgTraceResults" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Hop"            Binding="{Binding Hop}"         Width="50"/>
                    <DataGridTextColumn Header="Address"        Binding="{Binding Address}"     Width="160"/>
                    <DataGridTextColumn Header="Avg ms"         Binding="{Binding RoundtripMs}" Width="80"/>
                    <DataGridTextColumn Header="Hostname"       Binding="{Binding Hostname}"    Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

            <!-- Network Adapters -->
            <GroupBox Header="Network Adapters" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="130"/>
                </Grid.RowDefinitions>
                <Button x:Name="btnRefreshAdapters" Content="Refresh" Grid.Row="0"
                        HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgAdapters" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"         Binding="{Binding Name}"          Width="160"/>
                    <DataGridTextColumn Header="Status"       Binding="{Binding Status}"        Width="100"/>
                    <DataGridTextColumn Header="IPv4"         Binding="{Binding IPv4Address}"   Width="130"/>
                    <DataGridTextColumn Header="IPv6"         Binding="{Binding IPv6Address}"   Width="180"/>
                    <DataGridTextColumn Header="MAC"          Binding="{Binding MACAddress}"    Width="140"/>
                    <DataGridTextColumn Header="Speed (Mbps)" Binding="{Binding LinkSpeedMbps}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ════════════════════ SERVICES TAB ════════════════════ -->
      <TabItem Header="Services">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtServiceFilter" Width="240" Padding="4,3"
                     ToolTip="Filter by service name or display name"/>
            <Button x:Name="btnRefreshServices" Content="Refresh" Margin="10,0,0,0" Padding="14,5"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                       Margin="10,0"/>
            <Button x:Name="btnStartService"   Content="Start"   Padding="14,5"/>
            <Button x:Name="btnStopService"    Content="Stop"    Margin="4,0,0,0" Padding="14,5"/>
            <Button x:Name="btnRestartService" Content="Restart" Margin="4,0,0,0" Padding="14,5"/>
          </StackPanel>

          <DataGrid x:Name="dgServices" Grid.Row="1"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" SelectionMode="Single" CanUserSortColumns="True">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Background" Value="#D8F3DC"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Background" Value="#FFE0B2"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Background" Value="#FFF9C4"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name"         Binding="{Binding Name}"        Width="190"
                                  SortMemberPath="Name"/>
              <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*"
                                  SortMemberPath="DisplayName"/>
              <DataGridTextColumn Header="Status"       Binding="{Binding Status}"      Width="100"
                                  SortMemberPath="Status"/>
              <DataGridTextColumn Header="Start Type"   Binding="{Binding StartType}"   Width="110"
                                  SortMemberPath="StartType"/>
              <DataGridTextColumn Header="PID"          Binding="{Binding ProcessId}"   Width="65"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ════════════════════ STORAGE TAB ════════════════════ -->
      <TabItem Header="Storage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">

            <!-- Drive Summary -->
            <GroupBox Header="Drive Summary" Margin="0,0,0,8" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="110"/>
                </Grid.RowDefinitions>
                <Button x:Name="btnRefreshDrives" Content="Refresh" Grid.Row="0"
                        HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgDrives" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Drive"    Binding="{Binding Drive}"   Width="65"/>
                    <DataGridTextColumn Header="Label"    Binding="{Binding Label}"   Width="130"/>
                    <DataGridTextColumn Header="Total GB" Binding="{Binding TotalGB}" Width="90"/>
                    <DataGridTextColumn Header="Free GB"  Binding="{Binding FreeGB}"  Width="90"/>
                    <DataGridTemplateColumn Header="Used %" Width="180">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                            <ProgressBar Value="{Binding UsedPct}" Maximum="100"
                                         Width="110" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UsedPct, StringFormat={}{0:F1}%}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

            <!-- Large File Finder -->
            <GroupBox Header="Large File Finder" Margin="0,0,0,8" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="170"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                  <TextBlock Text="Path:" VerticalAlignment="Center" Margin="0,0,6,0" Width="38"/>
                  <TextBox x:Name="txtScanPath" Width="280" Padding="4,3" Text="C:\"/>
                  <TextBlock Text="Min size (MB):" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  <TextBox x:Name="txtMinSizeMB" Width="65" Padding="4,3" Text="100"/>
                  <Button x:Name="btnScanFiles"  Content="Scan"   Margin="10,0,0,0" Padding="14,5"/>
                  <Button x:Name="btnCancelScan" Content="Cancel" Margin="6,0,0,0"  Padding="14,5"
                          Visibility="Collapsed"/>
                </StackPanel>
                <DataGrid x:Name="dgLargeFiles" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Path"          Binding="{Binding FullName}"      Width="*"/>
                    <DataGridTextColumn Header="Size (MB)"     Binding="{Binding SizeMB}"        Width="100"/>
                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastWriteTime}" Width="140"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

            <!-- Temp Cleanup -->
            <GroupBox Header="Temp Directory Cleanup" Margin="0,0,0,8" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="80"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                  <Button x:Name="btnCalculateTempSize" Content="Calculate Size"   Padding="14,5"/>
                  <Button x:Name="btnCleanTemp"         Content="Clean Temp Files" Padding="14,5"
                          Margin="8,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="dgTempInfo" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Directory"  Binding="{Binding TempDir}"   Width="*"/>
                    <DataGridTextColumn Header="Size (MB)"  Binding="{Binding SizeMB}"    Width="110"/>
                    <DataGridTextColumn Header="File Count" Binding="{Binding FileCount}" Width="100"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

            <!-- Disk Health -->
            <GroupBox Header="Disk Health" Padding="8,6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="110"/>
                </Grid.RowDefinitions>
                <Button x:Name="btnRefreshDiskHealth" Content="Refresh" Grid.Row="0"
                        HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgDiskHealth" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"              Binding="{Binding FriendlyName}"      Width="*"/>
                    <DataGridTextColumn Header="Model"             Binding="{Binding Model}"             Width="200"/>
                    <DataGridTextColumn Header="Size (GB)"         Binding="{Binding SizeGB}"            Width="90"/>
                    <DataGridTextColumn Header="Health"            Binding="{Binding HealthStatus}"      Width="100"/>
                    <DataGridTextColumn Header="Operational"       Binding="{Binding OperationalStatus}" Width="120"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </GroupBox>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
